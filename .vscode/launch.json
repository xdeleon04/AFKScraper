{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node-terminal",
            "name": "Run Script: dev",
            "request": "launch",
            "command": "npm run dev",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Launch Edge",
            "request": "launch",
            "type": "msedge",
            "url": "http://localhost:9002",
            "webRoot": "${workspaceFolder}",
            "preLaunchTask": "Wait for localhost:9002"
        }
    ],
    "compounds": [
        {
            "name": "Dev + Edge",
            "configurations": ["Run Script: dev", "Launch Edge"],
            "stopAll": true
        }
    ]
}